---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import cta from '../../shell/cta.html?raw'
import { articleHtml } from '../../components/ArticleRenderer'
import { getPosts, postPath, readPost } from '../../lib/posts'
import { imageSize, pictureHtml } from '../../lib/images'
import { categoryLabel } from '../../lib/categories'
import { BLOG_PATH, SITE_NAME, absoluteUrl, breadcrumb, formatDate, orgRef, paragraphs } from '../../lib/site'

export async function getStaticPaths() {
  const sorted = await getPosts()
  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      prev: sorted[i + 1] ? { slug: sorted[i + 1].slug, title: sorted[i + 1].entry.title } : null,
      next: sorted[i - 1] ? { slug: sorted[i - 1].slug, title: sorted[i - 1].entry.title } : null,
    },
  }))
}

const { slug } = Astro.params
const { prev, next } = Astro.props
const post = (await readPost(slug!))!
const content = await post.content()
const path = postPath(slug!)

const text = (node: any): string => (typeof node.text === 'string' ? node.text : (node.children ?? []).map(text).join(''))
const words = (nodes: any[]): number => nodes.reduce((n, node) => n + (typeof node.text === 'string' ? node.text.split(/\s+/).filter(Boolean).length : 0) + words(node.children ?? []), 0)
const readingTime = Math.max(1, Math.round(words(content) / 200))

// Índice: los h2 y h3 del cuerpo
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const headings = content
  .filter((n: any) => n.type === 'heading' && (n.level === 2 || n.level === 3))
  .map((n: any) => ({ level: n.level, text: text(n), id: slugify(text(n)) }))
const body = articleHtml(content, headings.map((h) => h.id))

const category = categoryLabel(post.category)
const lead = paragraphs(post.excerpt)
const description = lead.join(' ')
const cover = post.coverImage
const graph = [
  {
    '@type': 'BlogPosting',
    '@id': absoluteUrl(`${path}#article`),
    headline: post.title,
    description,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    datePublished: post.publishedAt,
    inLanguage: 'es',
    articleSection: category,
    wordCount: words(content),
    author: { '@type': 'Person', name: post.author },
    publisher: orgRef,
    isPartOf: { '@id': absoluteUrl(`${BLOG_PATH}#blog`) },
    ...(cover ? { image: { '@type': 'ImageObject', url: absoluteUrl(cover), ...imageSize(cover) && { width: imageSize(cover)!.width, height: imageSize(cover)!.height } } } : {}),
  },
  breadcrumb([[SITE_NAME, '/'], ['Blog', BLOG_PATH], [post.title, path]]),
]
---

<BaseLayout title={`${post.title} | Blog de ${SITE_NAME}`} description={description} path={path} image={cover ?? '/og/blog-es.png'} imageAlt={post.title} type="article" graph={graph}>
  <article class="article">
    <header class="section band band--first art-head">
      <nav aria-label="Migas de pan">
        <ol class="crumbs">
          <li><a href={BLOG_PATH}>Blog</a></li>
          <li>{category}</li>
        </ol>
      </nav>
      <h1 class="art-head__title">{post.title}</h1>
      {lead.map((p) => <p class="art-head__lead">{p}</p>)}
      <p class="art-head__meta">
        <span>{post.author}</span>
        {post.publishedAt && <span><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></span>}
        <span class="num">{readingTime} min de lectura</span>
      </p>
      {cover && <Fragment set:html={pictureHtml(cover, '', { eager: true, className: 'art-head__cover' })} />}
    </header>

    <div class="section band art-body">
      <div class="prose" set:html={body} />
      {headings.length > 0 && (
        <aside class="toc" aria-label="En este artículo">
          <p class="toc__title">En este artículo</p>
          {headings.map((h) => <a class={`toc__link toc__link--h${h.level}`} href={`#${h.id}`} data-id={h.id}>{h.text}</a>)}
        </aside>
      )}
    </div>

    {(prev || next) && (
      <nav class="section band art-nav" aria-label="Más artículos">
        {prev ? <a class="art-nav__link" href={postPath(prev.slug)}><span>Anterior</span>{prev.title}</a> : <span />}
        {next ? <a class="art-nav__link art-nav__link--next" href={postPath(next.slug)}><span>Siguiente</span>{next.title}</a> : <span />}
      </nav>
    )}
  </article>

  <Fragment set:html={cta} />
</BaseLayout>

<script>
  // Índice: marca la sección que se está leyendo
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc__link')]
  const targets = links.map((l) => document.getElementById(l.dataset.id!)).filter(Boolean) as HTMLElement[]
  if (targets.length) {
    const io = new IntersectionObserver((entries) => {
      const hit = entries.find((e) => e.isIntersecting)
      if (hit) for (const l of links) l.toggleAttribute('aria-current', l.dataset.id === hit.target.id)
    }, { rootMargin: '-80px 0px -70% 0px' })
    targets.forEach((t) => io.observe(t))
  }
</script>
