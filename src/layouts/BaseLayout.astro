---
// Shell de la landing (nav, footer y estilos copiados por scripts/sync-shell.mjs) y metadata SEO:
// canonical en getrelvo.ai, Open Graph, JSON-LD y noindex fuera de producción.
import header from '../shell/header.html?raw'
import footer from '../shell/footer.html?raw'
import analytics from '../shell/analytics.html?raw'
import '../styles/landing/tokens.css'
import '../styles/landing/site.css'
import '../styles/landing/blocks.css'
import '../styles/blog.css'
import { PRODUCTION, SITE_NAME, absoluteUrl, baseGraph } from '../lib/site'

interface Props {
  title: string
  description: string
  path: string
  image: string
  imageAlt: string
  type?: 'website' | 'article'
  graph?: object[]
  noindex?: boolean
}

const { title, description, path, image, imageAlt, type = 'website', graph = [], noindex = false } = Astro.props
const url = absoluteUrl(path)
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...baseGraph(), ...graph] }).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content={PRODUCTION && !noindex ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="description" content={description} />
    {!noindex && (
      <>
        <link rel="canonical" href={url} />
        <link rel="alternate" hreflang="es" href={url} />
        <link rel="alternate" hreflang="x-default" href={url} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={`Blog de ${SITE_NAME}`} href={absoluteUrl('/blog/rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(image)} />
    <script type="application/ld+json" set:html={ld} />
    {PRODUCTION && <Fragment set:html={analytics} />}
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/blog/shell/logo-mark-dark.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/blog/shell/logo-mark-light.svg" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/blog/fonts/instrument-sans/InstrumentSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/blog/fonts/instrument-sans/InstrumentSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="site">
      <Fragment set:html={header} />
      <div class="frame">
        <main>
          <slot />
        </main>
      </div>
      <Fragment set:html={footer} />
    </div>
    <script>
      import '../scripts/nav'
    </script>
  </body>
</html>
